{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=MeetingRecorderDb;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "MeetingRecorder",
    "Audience": "MeetingRecorder.Client",
    "Key": "dev-only-key-change-me-32chars-minimum!!",
    "ExpiryMinutes": 120,
    "RefreshExpiryDays": 7
  },
  "Urls": {
    "SigningKey": "dev-stream-signing-key-change-me",
    "ExpiryMinutes": 10
  },
  "Storage": {
    "RootPath": "uploads"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173", "http://localhost:8080" ]
  },
  "Https": {
    "EnableRedirection": true
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedOnStartup": true
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
