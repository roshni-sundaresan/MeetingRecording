{
  "info": {
    "name": "Meeting Recorder API",
    "description": "Production-ready backend: JWT auth, CRUD, chunked uploads (start/chunk/status/retry/complete). All endpoints return the standard envelope {success,message,data,errors,statusCode}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@meetingrecorder.dev\",\n  \"password\": \"Admin@123\"\n}" },
            "description": "Seed admin: admin@meetingrecorder.dev / Admin@123. Seed user: demo@meetingrecorder.dev / Demo@123."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success) { pm.collectionVariables.set('token', json.data.token); }",
                  "pm.test('login succeeds', () => pm.expect(json.success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"new.user@example.com\",\n  \"name\": \"New User\",\n  \"mobile\": \"+91 98765 43210\",\n  \"password\": \"Str0ngPass!\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users (admin)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users?page=1&pageSize=10&search=&sortBy=name&sortOrder=asc", "host": ["{{baseUrl}}"], "path": ["api", "users"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get user",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/22222222-2222-2222-2222-222222222222", "host": ["{{baseUrl}}"], "path": ["api", "users", ":id"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{baseUrl}}/api/users/22222222-2222-2222-2222-222222222222", "host": ["{{baseUrl}}"], "path": ["api", "users", ":id"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Demo User Updated\",\n  \"mobile\": \"+91 90000 00002\"\n}" }
          }
        },
        {
          "name": "Delete user (soft)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/users/22222222-2222-2222-2222-222222222222", "host": ["{{baseUrl}}"], "path": ["api", "users", ":id"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Recordings",
      "item": [
        {
          "name": "List recordings",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/recordings?page=1&pageSize=10&search=&sortBy=createdAt&sortOrder=desc", "host": ["{{baseUrl}}"], "path": ["api", "recordings"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get recording",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/recordings/aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa", "host": ["{{baseUrl}}"], "path": ["api", "recordings", ":id"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Create recording",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/recordings", "host": ["{{baseUrl}}"], "path": ["api", "recordings"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"API Design Review\",\n  \"type\": 4,\n  \"duration\": \"00:35:00\",\n  \"summary\": \"Reviewed the OpenAPI contract.\",\n  \"sourceLanguageCode\": \"en\",\n  \"isRecording\": false,\n  \"bookmarked\": false\n}" }
          }
        },
        {
          "name": "Update recording",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{baseUrl}}/api/recordings/aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa", "host": ["{{baseUrl}}"], "path": ["api", "recordings", ":id"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"notes\": \"Share the deck with the team.\"\n}" }
          }
        },
        {
          "name": "Bookmark recording",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/api/recordings/aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa/bookmark", "host": ["{{baseUrl}}"], "path": ["api", "recordings", ":id", "bookmark"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"bookmarked\": true\n}" }
          }
        }
      ]
    },
    {
      "name": "Batch Upload",
      "item": [
        {
          "name": "1. Start upload",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/upload/start", "host": ["{{baseUrl}}"], "path": ["api", "upload", "start"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"fileName\": \"team-sync.mp4\",\n  \"type\": 4,\n  \"totalChunks\": 3,\n  \"sourceLanguageCode\": \"en\",\n  \"fileSizeBytes\": 300\n}" },
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "const json = pm.response.json();",
                    "if (json.success) { pm.collectionVariables.set('batchId', json.data.batchId); }"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "2a. Upload chunk 1",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/upload/chunk", "host": ["{{baseUrl}}"], "path": ["api", "upload", "chunk"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "batchId", "value": "{{batchId}}" },
                { "key": "chunkNumber", "value": "1" },
                { "key": "totalChunks", "value": "3" },
                { "key": "userId", "value": "22222222-2222-2222-2222-222222222222" },
                { "key": "uploadedAt", "value": "2026-07-29T10:00:00Z" },
                { "key": "summary", "value": "Chunk metadata rides along with every chunk." },
                { "key": "transcript", "value": "..." },
                { "key": "actions", "value": "..." },
                { "key": "notes", "value": "..." },
                { "key": "file", "type": "file", "src": "/tmp/chunk_1.bin" }
              ]
            }
          }
        },
        {
          "name": "2b. Upload chunk 2",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/upload/chunk", "host": ["{{baseUrl}}"], "path": ["api", "upload", "chunk"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "batchId", "value": "{{batchId}}" },
                { "key": "chunkNumber", "value": "2" },
                { "key": "totalChunks", "value": "3" },
                { "key": "userId", "value": "22222222-2222-2222-2222-222222222222" },
                { "key": "file", "type": "file", "src": "/tmp/chunk_2.bin" }
              ]
            }
          }
        },
        {
          "name": "2c. Upload chunk 3",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/upload/chunk", "host": ["{{baseUrl}}"], "path": ["api", "upload", "chunk"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "batchId", "value": "{{batchId}}" },
                { "key": "chunkNumber", "value": "3" },
                { "key": "totalChunks", "value": "3" },
                { "key": "userId", "value": "22222222-2222-2222-2222-222222222222" },
                { "key": "file", "type": "file", "src": "/tmp/chunk_3.bin" }
              ]
            }
          }
        },
        {
          "name": "3. Upload status",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/upload/status/{{batchId}}", "host": ["{{baseUrl}}"], "path": ["api", "upload", "status", ":batchId"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "4. Retry chunk",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/upload/retry", "host": ["{{baseUrl}}"], "path": ["api", "upload", "retry"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"batchId\": \"{{batchId}}\",\n  \"chunkNumber\": 2\n}" }
          }
        },
        {
          "name": "5. Complete upload",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/upload/complete/{{batchId}}", "host": ["{{baseUrl}}"], "path": ["api", "upload", "complete", ":batchId"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    }
  ]
}
