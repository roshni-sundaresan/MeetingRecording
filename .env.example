# ==============================================================================
# Meeting Recorder API - Environment Secrets Template
# Copy this file to .env and fill in real values.
# ==============================================================================

# RSA 2048-bit Private Key (PKCS#8 PEM format)
RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
RSA_PRIVATE_KEY_PATH="private_key.pem"

# RSA 2048-bit Public Key (PKCS#8 / X.509 SubjectPublicKeyInfo PEM format)
RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
RSA_PUBLIC_KEY_PATH="public_key.pem"
